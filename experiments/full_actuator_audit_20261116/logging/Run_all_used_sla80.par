#FullDataName Generic VS Commands`LTR + DLC PMPC`PMPC mode
DEFINE_OUTPUT LTR=0; ; LTR
EQ_OUT LTR = (Fz_R1 + Fz_R2 - Fz_L1 - Fz_L2) / (Fz_L1+Fz_L2 + Fz_R1+Fz_R2+0.00001)
DEFINE_OUTPUT TrackingError=0; ; TrackingError
EQ_OUT TrackingError = Lat_Veh-Lat_Targ
DEFINE_OUTPUT Speed=0; ; TrackingError
EQ_OUT Speed = sqrt(Vx^2+Vy^2)
DEFINE_PARAMETER PMPC_BASELINE = 0 ; - ; 1=no control baseline, 0=PMPC
DEFINE_PARAMETER PMPC_FISHHOOK = 0 ; - ; 1=fishhook, 0=DLC path following
DEFINE_PARAMETER PMPC_CARGO    = 0 ; kg ; roof cargo payload
LOG_ENTRY Used Dataset: Generic VS Commands; { PMPC mode } LTR + DLC PMPC
